# Copy to .env for local development
# cp .env.example .env

VITE_APP_NAME=errePlate

# Required — Laravel API base (include /api)
VITE_API_URL=http://localhost:8000/api

# App origin (OAuth redirects, links)
VITE_FRONTEND_URL=http://localhost:5173

# Optional — maps on browse/profile
VITE_GOOGLE_MAPS_KEY=
